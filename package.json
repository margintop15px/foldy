{
  "name": "foldy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "foldy": "node src/cli.ts",
    "test": "node --test",
    "test:live": "FOLDY_LIVE=1 node --test --test-concurrency=1",
    "bench": "FOLDY_LIVE=1 node tests/quality/run.ts",
    "bench:score": "node tests/quality/score.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@napi-rs/canvas": "1.0.9",
    "pdfjs-dist": "6.3.289",
    "sharp": "0.35.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
